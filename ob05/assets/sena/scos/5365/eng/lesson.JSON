ve)", "type": "part_speech"}, {"content": "Example: Bright colors are common in Indian art", "type": "example"}, {"content": "engenn4le07ob05aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": " element ", "type": "name"}, {"content": "an important feature ", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: These are common elements in Indian paintings", "type": "example"}, {"content": "engenn4le07ob05aud06", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le07ob05re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Go on the Internet. Visit a museum's website.", "type": "text"}, {"content": "Look at some of the paintings on the website.", "type": "text"}, {"content": "What do you see in the painting? Where is the painting from?", "type": "text"}, {"content": "Do some research. What are the traditions of art from the country the painting comes from?", "type": "text"}, {"content": "Write 5 sentences from the information you found.", "type": "text"}], "type": "takeaway_extension"}, {"contents": [{"content": "I read information about a museum.", "type": "text"}, {"content": "I identify the background of some paintings.", "type": "text"}, {"content": "I read about the traditions of art from other countries.", "type": "text"}, {"content": "I write a paragraph about art.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn4le07ob05re2aud01", "images": [{"image": "engenn4le07ob05re2img05.jpg", "id": 0, "time": "0", "text": ""}, {"image": "engenn4le07ob05re2img05.jpg", "id": 1, "time": "0500", "text": "<span class =\"strong\">Aunt Nelly</span>: Vanessa, there's an exhibit on Indian art at the museum nearby. Shall we go?<br />\n<span class =\"strong\">Vanessa</span>: Sure, let's go. I really don't know much about I