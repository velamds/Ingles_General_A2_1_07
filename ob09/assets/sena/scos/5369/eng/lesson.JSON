{"_data": [{"contents": [{"content": "Vanessa in Cooking School: Indian Food", "type": "lesson_name"}, {"content": "I'm Going to the Market", "type": "unit_name"}, {"content": 9, "type": "position"}, {"content": "stub", "type": "origin"}, {"content": 7, "type": "lesson"}, {"content": "A2.1", "type": "level"}], "type": "metadata"}, {"contents": [{"content": "false", "type": "test"}], "type": "achievment_test"}, {"contents": [{"content": "Accurately use information about travel and vacations in social situations.", "type": "primary"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_1"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_2"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_3"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_4"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_5"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_6"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_7"}, {"content": "Identifies general information in short written or spoken conversations.", "type": "secondary_8"}], "type": "objectives"}, {"contents": [{"content": "Talking About Future Plans", "type": "heading"}, {"content": "You use the Present Continuous tense to talk about:<br> <br><ul><li>events happening now or</li> <li>planned events in the near future</li></ul></br>  When you talk about events in the near future, you use time markers and prepositions of time like: <br>  <br> <ul><li>in _____ minutes/hours/days</li> <li>this morning/afternoon/evening</li> <li>tonight</li> <li>tomorrow</li> <li>on Tuesday (a future day or date)</li></ul></br>", "type": "describer"}, {"content": "Vanessa's studying in the library. (now)", "type": "example"}, {"content": "She's studying at Helen's house this evening. (future)", "type": "example"}, {"content": " Her exam is happening on Tuesday. (future)", "type": "example"}, {"content": "Aunt Nelly is leaving. (now)", "type": "example"}, {"content": " Aunt Nelly is leaving tomorrow morning at 7:30. (future)", "type": "example"}], "type": "learning_points"}, {"contents": [{"content": "a bit", "type": "name"}, {"content": "a short period of time", "type": "definition"}, {"content": "(expression)", "type": "part_speech"}, {"content": "Example: I'm going to the market in a bit.", "type": "example"}, {"content": "engenn4le07ob09aud01", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "These are words you use to talk about intentions. ", "type": "text"}], "type": "target_word_describer"}, {"contents": [{"content": "takeout", "type": "name"}, {"content": "food you buy at a restaurant to eat at home", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I want to buy takeout.", "type": "example"}, {"content": "engenn4le07ob09aud02", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "takeout menu", "type": "name"}, {"content": "a list of all the kinds of food that are available to buy as takeout", "type": "definition"}, {"content": "(noun)", "type": "part_speech"}, {"content": "Example: I'm looking for the Indian restaurant's takeout menu.", "type": "example"}, {"content": "engenn4le07ob09aud03", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "once", "type": "name"}, {"content": "from the time when something happens", "type": "definition"}, {"content": "(adverb)", "type": "part_speech"}, {"content": "Example: I'm going to call for takeout once I find the number.", "type": "example"}, {"content": "engenn4le07ob09aud04", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to decide", "type": "name"}, {"content": "to make a choice about something ", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: I am going to decide on what to get.", "type": "example"}, {"content": "engenn4le07ob09aud05", "type": "audio"}], "type": "target_word"}, {"contents": [{"content": "to try out", "type": "name"}, {"content": " to test something", "type": "definition"}, {"content": "(verb)", "type": "part_speech"}, {"content": "Example: We should try out that new place.", "type": "example"}, {"content": "engenn4le07ob09aud06", "type": "audio"}], "type": "target_word"}, {"content": "engenn4le07ob09re1img01.jpg", "type": "background_image"}, {"contents": [{"content": "Fill in the table below about your plans for next week.", "type": "text"}, {"content": "Write 4-5 sentences about your future plans.", "type": "text"}, {"content": "Read your sentences to a partner.", "type": "text"}, {"content": "Listen to their sentences.", "type": "text"}, {"content": "{\"rows\":5,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Monday</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Tuesday</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Wednesday</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Thursday</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<span class=\\\"strong\\\">Friday</span>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" \\\"}\"],\"styles\":\"\"}", "type": "table"}], "type": "takeaway_extension"}, {"contents": [{"content": "I organize my weekly plans in a table.", "type": "text"}, {"content": "I express time in complete statements about future plans.", "type": "text"}, {"content": "I read aloud to my partner about my future plans.", "type": "text"}, {"content": "I listen to my partner's future plans.", "type": "text"}], "type": "takeaway_assessment"}], "labs": [{"stimuli": [{"type": "welcome", "_data": [], "contents": [{}], "id": 0, "template_override": 1}, {"title": "", "contents": [{"value": {"audiosrc": "engenn4le07ob09re2aud01", "images": [{"image": "engenn4le07ob09re2img05.jpg", "id": 0, "time": "0", "text": "<span class=\"strong\">Aunt Nelly</span>: Vanessa, I'm going to the market in a bit. Would you like to come?<br>\n<span class=\"strong\">Vanessa</span>: I'm not coming, sorry. I'm preparing for my exam. It's on Tuesday! <br>\n<span class=\"strong\">Aunt Nelly</span>: That's alright."}, {"image": "engenn4le07ob09re2img05.jpg", "id": 1, "time": "11000", "text": "<span class=\"strong\">Vanessa</span>: Are you leaving soon? I want takeout. <br>\n<span class=\"strong\">Aunt Nelly</span>: In 30 minutes. <br>\n<span class=\"strong\">Vanessa</span>: Aunt Nelly, I'm looking for the Indian restaurant's takeout menu. Where is it?<br>\n<span class=\"strong\">Aunt Nelly</span>: Are you going to order Indian? We should try out that new place soon.<br>\n<span class=\"strong\">Vanessa</span>: I'm thinking about it. I'm not going to cook tonight. Maybe next week."}, {"image": "engenn4le07ob09re2img05.jpg", "id": 2, "time": "33000", "text": "<span class=\"strong\">Aunt Nelly</span>: Okay here's the menu. You order and I can pick it up after I leave the market. I'm going to leave now. Be back at 8.<br>\n<span class=\"strong\">Vanessa</span>: Bye. I'm going to call them once I decide on what to get."}], "coverimg": "engenn4le07ob09re2img05.jpg"}, "type": "slideshow"}], "template_override": 1, "_data": [], "type": "audio", "id": 1}], "exercises": [{"id": 0, "stimuli_ids": [0], "template_override": 1, "_data": [{"contents": [{"content": "I can talk about intentions and plans.", "type": "Learning Outcomes"}, {"content": "I can ask and talk about what people are doing.", "type": "Learning Outcomes"}, {"content": "I can talk about the time of an event.", "type": "Learning Outcomes"}, {"content": "What are your plans for the weekend?", "type": "Free Header Item"}, {"content": "What are you going to do next month?", "type": "Free Header Item"}], "type": "instructions"}, {"contents": [{"content": "Welcome", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "You have 2 tries", "type": "text"}, {"content": "you have 1 attempt left", "type": "text"}], "incorrect_feedback": [{"content": "try again", "type": "text"}, {"content": "Maybe next time", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct"}, "type": "feedback"}, {"content": "Ask your partner:", "type": "free_header_text"}, {"content": "Are you busy? Do you want to go to the market?", "type": "free_type_text_area"}], "type": "WLC", "img_path": "", "questions": []}, {"id": 1, "stimuli_ids": [1], "template_override": 1, "_data": [{"contents": [{"content": "Aunt Nelly is going to the <span class=\"tool-tip\" id=\"tip_1_0\">market</span>. Is Vanessa going with her?", "type": "text"}], "type": "instructions"}, {"contents": [{"content": "Content", "type": "group_name"}], "type": "group"}, {"content": {"attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}], "allowed_attempts": 2, "correct_feedback": "Correct!"}, "type": "feedback"}, {"contents": [{"content":