{"_data": [{"type": "metadata", "contents": [{"type": "lesson_name", "content": "Vanessa in Cooking School: Indian Food"}, {"type": "unit_name", "content": "On the Way Home"}, {"type": "position", "content": 7}, {"type": "origin", "content": "scholar > Famous Structures > The Taj Mahal"}, {"type": "lesson", "content": 7}, {"type": "level", "content": "A2.1"}]}, {"type": "achievment_test", "contents": [{"type": "test", "content": "false"}]}, {"type": "objectives", "contents": [{"type": "primary", "content": "Relate information about health and healthy habits in communicative situations."}, {"type": "secondary_1", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_2", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_3", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_4", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_5", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_6", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_7", "content": "Identifies general information in short written or spoken conversations."}, {"type": "secondary_8", "content": "Identifies general information in short written or spoken conversations."}]}, {"type": "background_image", "content": "engenn4le07ob07re1img01.jpg"}, {"type": "learning_points", "contents": [{"type": "heading", "content": "Pronouns One vs. Ones"}, {"type": "describer", "content": "You can use the pronouns <span class=\"italic\">one</span> (singular) and <span class=\"italic\">ones</span> (plural) to replace nouns. You often use demonstratives (this, that, these, those) with one and ones.<br>   <br>Example:<br> <span class=\"italic\">There are two pies. I like <span class=\"strong\">this one</span>. It's an apple pie.</span><br>You can also use them after <span class=\"italic\">Which</span> in questions.<br>   <br>Example:<br> <span class=\"italic\">Which one?</span> or <span class=\"italic\">Which ones?</span>"}, {"type": "example", "content": "I have a blue pen and a red pen. Which one do you want?"}, {"type": "example", "content": "I have a pair of blue shoes, and a pair of red shoes. Which ones do you want?"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "to crave "}, {"type": "definition", "content": "to have a strong desire for something"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I'm craving pie. Let's go to the bakery.  "}, {"type": "audio", "content": "engenn4le07ob07aud01"}]}, {"type": "target_word_describer", "contents": [{"type": "text", "content": "These are words you use to talk about pies."}]}, {"type": "target_word", "contents": [{"type": "name", "content": "apple pie "}, {"type": "definition", "content": "a pie baked with an apple filling "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: My favorite is apple pie."}, {"type": "audio", "content": "engenn4le07ob07aud02"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cherry pie"}, {"type": "definition", "content": "a pie baked with a filling made from a small round red fruit "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: These are cherry pies."}, {"type": "audio", "content": "engenn4le07ob07aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "pumpkin pie"}, {"type": "definition", "content": "a pie baked with a filling made from a large orange fruit that grows on the ground "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We eat pumpkin pie in October."}, {"type": "audio", "content": "engenn4le07ob07aud04"}]}, {"type": "target_word", "conte