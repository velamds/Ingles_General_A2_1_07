content": "engenn4le07ob02aud03"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "clove "}, {"type": "definition", "content": "a black spice with a sweet smell "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You can add some cloves to your curry."}, {"type": "audio", "content": "engenn4le07ob02aud04"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "coriander seed "}, {"type": "definition", "content": "small brown seeds from a herb "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: You should include some coriander seeds."}, {"type": "audio", "content": "engenn4le07ob02aud05"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "nutmeg "}, {"type": "definition", "content": "a spice made from the seed of a tropical tree "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: Do you have any nutmeg?"}, {"type": "audio", "content": "engenn4le07ob02aud06"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "cardamom "}, {"type": "definition", "content": "the seeds of an Asian fruit "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We don't have any cardamom."}, {"type": "audio", "content": "engenn4le07ob02aud07"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "aroma "}, {"type": "definition", "content": "a strong pleasant smell "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: The seeds are ready when you can smell the aroma."}, {"type": "audio", "content": "engenn4le07ob02aud08"}]}, {"type": "target_word", "contents": [{"type": "name", "content": "bring the flavor out "}, {"type": "definition", "content": "use to say something makes it easier to taste something "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: How do you bring the fl